@startuml
left to right direction
skinparam packageStyle rectangle

actor Admin
actor Pharmacist
actor Cashier
actor Supplier
actor Customer

rectangle "Pharmacy Management System" {
  usecase "Manage Users & Branches" as UC1
  usecase "Manage Medicines & Batches" as UC2
  usecase "Generate Reports" as UC3
  
  usecase "Manage Purchases" as UC4
  usecase "Manage Sales & POS" as UC5
  usecase "Manage Payments" as UC6
  usecase "Manage Customer Accounts" as UC7
  usecase "View Notifications" as UC8

  Admin --> UC1
  Admin --> UC2
  Admin --> UC3
  Admin --> UC4
  Admin --> UC5
  Admin --> UC6
  Admin --> UC7
  Admin --> UC8

  Pharmacist --> UC2
  Pharmacist --> UC4
  Pharmacist --> UC5
  Pharmacist --> UC7
  Pharmacist --> UC8

  Cashier --> UC5
  Cashier --> UC6
  Cashier --> UC7

  UC4 <-- Supplier
  UC5 <-- Customer
  UC7 <-- Customer
}
@enduml
